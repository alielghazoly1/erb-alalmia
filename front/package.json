{
  "name": "ceo-desktop",
  "version": "1.0.0",
  "description": "CEO Management Desktop App",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-query": "^5.100.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.15.1",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.0",
    "react-scripts": "5.0.1",
    "react-to-print": "^3.3.0",
    "swapy": "^1.0.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env CI=false craco build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.ceo.management",
    "productName": "CEO Management",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "alielghazoly1",
      "repo": "erb-alalamia"
    },
    "extraResources": [
      {
        "from": "../back",
        "to": "backend",
        "filter": [
          "**/*",
          "!mongo_data/**",
          "!prisma/migrations/**",
          "!node_modules/.cache/**",
          "!*.log"
        ]
      },
      {
        "from": "../back/node_modules",
        "to": "backend/node_modules"
      }
    ],
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CEO Management",
      "installerLanguages": [
        "ar"
      ],
      "language": "1025"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/logo.png"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
