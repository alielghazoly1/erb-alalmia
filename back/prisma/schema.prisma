generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// المستخدم — يخضع لـ RBAC مع granular permissions في UserPermission
model User {
  id                    String               @id @default(uuid()) @db.Uuid
  name                  String               @db.VarChar(120)
  username              String               @unique @db.VarChar(60)
  password              String
  role                  Role                 @default(user)
  scope                 WarehouseScope       @default(both)
  isActive              Boolean              @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  auditLogs             AuditLog[]
  cashRegisters         CashRegister[]       @relation("CashRegisterUser")
  customersCreated      Customer[]           @relation("CustomerCreatedBy")
  customersUpdated      Customer[]           @relation("CustomerUpdatedBy")
  manufacturingApproved ManufacturingOrder[] @relation("ManufacturingApprovedBy")
  manufacturingCreated  ManufacturingOrder[] @relation("ManufacturingCreatedBy")
  paymentsCreated       Payment[]
  priceListsUpdated     PriceList[]
  purchasesApproved     PurchaseInvoice[]    @relation("PurchaseApprovedBy")
  purchasesCreated      PurchaseInvoice[]    @relation("PurchaseCreatedBy")
  purchasesEdited       PurchaseInvoice[]    @relation("PurchaseEditedBy")
  refreshTokens         RefreshToken[]
  returnsApproved       ReturnInvoice[]      @relation("ReturnApprovedBy")
  returnsCreated        ReturnInvoice[]      @relation("ReturnCreatedBy")
  saleInvoicesApproved  SaleInvoice[]        @relation("SaleApprovedBy")
  saleInvoicesCreated   SaleInvoice[]        @relation("SaleCreatedBy")
  saleInvoicesEdited    SaleInvoice[]        @relation("SaleEditedBy")
  seasonsCreated        Season[]             @relation("SeasonCreatedBy")
  stockAdjustments      StockAdjustment[]
  stockMovements        StockMovement[]
  suppliersCreated      Supplier[]           @relation("SupplierCreatedBy")
  transfersApproved     Transfer[]           @relation("TransferApprovedBy")
  transfersCreated      Transfer[]           @relation("TransferCreatedBy")
  treasuryEntries       TreasuryEntry[]      @relation("TreasuryUser")
  permissions           UserPermission[]

  @@index([username])
  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

/// صلاحيات حبيبية لكل مستخدم — مستقلة عن الـ Role
/// الـ Role هو baseline والـ UserPermission هو override
model UserPermission {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  permission Permission
  granted    Boolean    @default(true)
  grantedAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@index([permission])
  @@map("user_permissions")
}

/// Refresh Tokens للـ JWT rotation
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?   @db.VarChar(300)
  ipAddress String?   @db.VarChar(45)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// الموسم — وحدة العزل الأساسية لكل البيانات التشغيلية
model Season {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(100)
  code                String               @unique @db.VarChar(20)
  startDate           DateTime
  endDate             DateTime
  isActive            Boolean              @default(false)
  isClosed            Boolean              @default(false)
  isManufacturing     Boolean              @default(false)
  notes               String?
  closedAt            DateTime?
  createdById         String?              @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  cashRegisters       CashRegister[]
  openingStocks       ItemStock[]
  manufacturingOrders ManufacturingOrder[]
  payments            Payment[]
  purchaseInvoices    PurchaseInvoice[]
  returnInvoices      ReturnInvoice[]
  saleInvoices        SaleInvoice[]
  counters            SeasonCounter[]
  createdBy           User?                @relation("SeasonCreatedBy", fields: [createdById], references: [id])
  stockAdjustments    StockAdjustment[]
  stockMovements      StockMovement[]
  transfers           Transfer[]
  treasuryEntries     TreasuryEntry[]

  @@index([isActive])
  @@index([isClosed, startDate(sort: Desc)])
  @@map("seasons")
}

/// عدادات أرقام الفواتير — مستقلة لكل موسم ولكل نوع
/// نمط: {prefix}-{seasonCode}-{value:05d}  مثال: PUR-2025S1-00142
model SeasonCounter {
  id        String @id @default(uuid()) @db.Uuid
  seasonId  String @db.Uuid
  prefix    String @db.VarChar(10)
  value     Int    @default(0)
  startFrom Int    @default(1)
  season    Season @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, prefix])
  @@map("season_counters")
}

/// عداد عام للتسلسلات التي لا ترتبط بموسم
model GlobalCounter {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(50)
  value Int    @default(0)

  @@map("global_counters")
}

/// العميل
model Customer {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique @db.VarChar(30)
  name            String          @db.VarChar(200)
  phone           String?         @db.VarChar(20)
  phone2          String?         @db.VarChar(20)
  address         String?         @db.VarChar(300)
  type            CustomerType    @default(credit)
  creditLimit     Decimal         @default(0) @db.Decimal(15, 2)
  isActive        Boolean         @default(true)
  notes           String?
  openingBalance  Decimal         @default(0) @db.Decimal(15, 2)
  createdById     String?         @db.Uuid
  updatedById     String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  cashRegisters   CashRegister[]
  createdBy       User?           @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?           @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  payments        Payment[]
  returnInvoices  ReturnInvoice[]
  saleInvoices    SaleInvoice[]
  treasuryEntries TreasuryEntry[]

  @@index([name])
  @@index([isActive, type])
  @@index([deletedAt])
  @@map("customers")
}

/// المورد
model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique @db.VarChar(30)
  name             String            @db.VarChar(200)
  phone            String?           @db.VarChar(20)
  phone2           String?           @db.VarChar(20)
  address          String?           @db.VarChar(300)
  taxNumber        String?           @db.VarChar(50)
  isActive         Boolean           @default(true)
  notes            String?
  openingBalance   Decimal           @default(0) @db.Decimal(15, 2)
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  payments         Payment[]
  purchaseInvoices PurchaseInvoice[]
  returnInvoices   ReturnInvoice[]
  createdBy        User?             @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  treasuryEntries  TreasuryEntry[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@map("suppliers")
}

/// الصنف / المنتج
model Item {
  id                String                     @id @default(uuid()) @db.Uuid
  code              String                     @unique @db.VarChar(50)
  name              String                     @db.VarChar(200)
  category          String?                    @db.VarChar(100)
  subCategory       String?                    @db.VarChar(100)
  unit              String                     @default("كرتون") @db.VarChar(30)
  defaultWeight     Decimal                    @default(0) @db.Decimal(12, 3)
  lastPurchasePrice Decimal                    @default(0) @db.Decimal(15, 2)
  lastSalePrice     Decimal                    @default(0) @db.Decimal(15, 2)
  minStockQty       Float                      @default(0)
  isRawMaterial     Boolean                    @default(false)
  isActive          Boolean                    @default(true)
  notes             String?
  metadata          Json?                      @default("{}")
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  deletedAt         DateTime?
  stocks            ItemStock[]
  outputs           ManufacturingOutput[]
  rawMaterials      ManufacturingRawMaterial[]
  priceListLinks    PriceListItemLink[]
  purchaseItems     PurchaseInvoiceItem[]
  returnItems       ReturnInvoiceItem[]
  saleItems         SaleInvoiceItem[]
  stockAdjustments  StockAdjustmentLine[]
  stockMovements    StockMovement[]
  transferItems     TransferItem[]

  @@index([name])
  @@index([category, isActive])
  @@index([isActive, code])
  @@index([deletedAt])
  @@map("items")
}

/// مخزون الصنف لكل مخزن — normalized بدل JSON داخل Item
/// ده الحل الأذكى لإدارة المخزون في أنظمة الإنتاج
model ItemStock {
  id        String    @id @default(uuid()) @db.Uuid
  itemId    String    @db.Uuid
  warehouse Warehouse
  quantity  Decimal   @default(0) @db.Decimal(12, 3)
  weight    Decimal   @default(0) @db.Decimal(12, 3)
  seasonId  String?   @db.Uuid
  updatedAt DateTime  @updatedAt
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  season    Season?   @relation(fields: [seasonId], references: [id])

  @@unique([itemId, warehouse, seasonId])
  @@index([itemId, warehouse])
  @@index([warehouse, quantity])
  @@index([seasonId, warehouse])
  @@map("item_stocks")
}

/// العامل في التصنيع
model Worker {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(120)
  code                String               @unique @db.VarChar(30)
  scope               WarehouseScope       @default(ramses)
  phone               String?              @db.VarChar(20)
  notes               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  manufacturingOrders ManufacturingOrder[]

  @@index([scope, isActive])
  @@map("workers")
}

model SaleInvoice {
  id              String            @id @default(uuid()) @db.Uuid
  invoiceNumber   String            @unique @db.VarChar(30)
  docNumber       String            @db.VarChar(50)
  date            DateTime          @default(now()) @db.Timestamptz(6)
  customerId      String            @db.Uuid
  /// denormalized للسرعة — لا تُحدَّث بعد الإنشاء
  customerCode    String            @db.VarChar(30)
  customerName    String            @db.VarChar(200)
  warehouse       Warehouse
  totalAmount     Decimal           @db.Decimal(15, 2)
  totalWeight     Decimal           @default(0) @db.Decimal(12, 3)
  discountAmount  Decimal           @default(0) @db.Decimal(15, 2)
  netAmount       Decimal           @db.Decimal(15, 2)
  paidAmount      Decimal           @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal           @db.Decimal(15, 2)
  paymentMethod   PaymentMethod     @default(credit)
  cashAmount      Decimal           @default(0) @db.Decimal(15, 2)
  instapayAmount  Decimal           @default(0) @db.Decimal(15, 2)
  transferAmount  Decimal           @default(0) @db.Decimal(15, 2)
  status          InvoiceStatus     @default(pending)
  allowNegative   Boolean           @default(false)
  seasonId        String?           @db.Uuid
  notes           String?
  suspendReason   String?
  createdById     String            @db.Uuid
  approvedById    String?           @db.Uuid
  approvedAt      DateTime?         @db.Timestamptz(6)
  editedById      String?           @db.Uuid
  editedAt        DateTime?         @db.Timestamptz(6)
  editNotes       String?
  deletedAt       DateTime?         @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  items           SaleInvoiceItem[]
  approvedBy      User?             @relation("SaleApprovedBy", fields: [approvedById], references: [id])
  createdBy       User              @relation("SaleCreatedBy", fields: [createdById], references: [id])
  customer        Customer          @relation(fields: [customerId], references: [id])
  editedBy        User?             @relation("SaleEditedBy", fields: [editedById], references: [id])
  season          Season?           @relation(fields: [seasonId], references: [id])

  @@unique([docNumber, seasonId])
  @@index([customerId, status])
  @@index([customerId, seasonId, status])
  @@index([customerId, paymentMethod, status])
  @@index([seasonId, status])
  @@index([seasonId, date(sort: Desc)])
  @@index([seasonId, createdAt(sort: Desc)])
  @@index([warehouse, seasonId, status])
  @@index([status, date(sort: Desc)])
  @@index([date(sort: Desc)])
  @@index([deletedAt])
  @@map("sale_invoices")
}

model SaleInvoiceItem {
  id        String      @id @default(uuid()) @db.Uuid
  invoiceId String      @db.Uuid
  itemId    String      @db.Uuid
  itemCode  String      @db.VarChar(50)
  itemName  String      @db.VarChar(200)
  quantity  Decimal     @db.Decimal(12, 3)
  weight    Decimal     @db.Decimal(12, 3)
  price     Decimal     @db.Decimal(15, 2)
  discount  Decimal     @default(0) @db.Decimal(15, 2)
  total     Decimal     @db.Decimal(15, 2)
  sortOrder Int         @default(0)
  invoice   SaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      Item        @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
  @@map("sale_invoice_items")
}

model PurchaseInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  invoiceNumber   String                @unique @db.VarChar(30)
  docNumber       String                @db.VarChar(50)
  date            DateTime              @default(now()) @db.Timestamptz(6)
  supplierId      String                @db.Uuid
  supplierCode    String                @db.VarChar(30)
  supplierName    String                @db.VarChar(200)
  warehouse       Warehouse
  totalAmount     Decimal               @db.Decimal(15, 2)
  totalWeight     Decimal               @default(0) @db.Decimal(12, 3)
  discountAmount  Decimal               @default(0) @db.Decimal(15, 2)
  netAmount       Decimal               @db.Decimal(15, 2)
  paidAmount      Decimal               @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal               @db.Decimal(15, 2)
  status          InvoiceStatus         @default(pending)
  seasonId        String?               @db.Uuid
  notes           String?
  suspendReason   String?
  createdById     String                @db.Uuid
  approvedById    String?               @db.Uuid
  approvedAt      DateTime?             @db.Timestamptz(6)
  editedById      String?               @db.Uuid
  editedAt        DateTime?             @db.Timestamptz(6)
  editNotes       String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)
  items           PurchaseInvoiceItem[]
  approvedBy      User?                 @relation("PurchaseApprovedBy", fields: [approvedById], references: [id])
  createdBy       User                  @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  editedBy        User?                 @relation("PurchaseEditedBy", fields: [editedById], references: [id])
  season          Season?               @relation(fields: [seasonId], references: [id])
  supplier        Supplier              @relation(fields: [supplierId], references: [id])

  @@unique([docNumber, seasonId])
  @@index([supplierId, status])
  @@index([supplierId, seasonId])
  @@index([supplierId, seasonId, status])
  @@index([seasonId, status])
  @@index([seasonId, date(sort: Desc)])
  @@index([seasonId, createdAt(sort: Desc)])
  @@index([warehouse, seasonId, status])
  @@index([status, date(sort: Desc)])
  @@index([date(sort: Desc)])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id        String          @id @default(uuid()) @db.Uuid
  invoiceId String          @db.Uuid
  itemId    String          @db.Uuid
  itemCode  String          @db.VarChar(50)
  itemName  String          @db.VarChar(200)
  quantity  Decimal         @db.Decimal(12, 3)
  weight    Decimal         @db.Decimal(12, 3)
  price     Decimal         @db.Decimal(15, 2)
  discount  Decimal         @default(0) @db.Decimal(15, 2)
  total     Decimal         @db.Decimal(15, 2)
  sortOrder Int             @default(0)
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      Item            @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
  @@map("purchase_invoice_items")
}

model ReturnInvoice {
  id                 String              @id @default(uuid()) @db.Uuid
  invoiceNumber      String              @unique @db.VarChar(30)
  docNumber          String              @db.VarChar(50)
  date               DateTime            @default(now()) @db.Timestamptz(6)
  type               ReturnType
  customerId         String?             @db.Uuid
  customerCode       String?             @db.VarChar(30)
  customerName       String?             @db.VarChar(200)
  supplierId         String?             @db.Uuid
  supplierCode       String?             @db.VarChar(30)
  supplierName       String?             @db.VarChar(200)
  warehouse          Warehouse
  totalAmount        Decimal             @db.Decimal(15, 2)
  totalWeight        Decimal             @default(0) @db.Decimal(12, 3)
  refundMethod       RefundMethod        @default(none)
  refundCashAmount   Decimal             @default(0) @db.Decimal(15, 2)
  refundBankAmount   Decimal             @default(0) @db.Decimal(15, 2)
  status             ApprovalStatus      @default(pending)
  notes              String?
  /// رقم الفاتورة الأصلية كـ reference نصي
  originalInvoiceRef String?             @db.VarChar(30)
  seasonId           String?             @db.Uuid
  createdById        String              @db.Uuid
  approvedById       String?             @db.Uuid
  approvedAt         DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  items              ReturnInvoiceItem[]
  approvedBy         User?               @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  createdBy          User                @relation("ReturnCreatedBy", fields: [createdById], references: [id])
  customer           Customer?           @relation(fields: [customerId], references: [id])
  season             Season?             @relation(fields: [seasonId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])

  @@index([customerId, type, status])
  @@index([customerId, type, seasonId])
  @@index([supplierId, type, status])
  @@index([supplierId, type, seasonId])
  @@index([seasonId, type, status])
  @@index([seasonId, createdAt(sort: Desc)])
  @@index([date(sort: Desc)])
  @@map("return_invoices")
}

model ReturnInvoiceItem {
  id        String        @id @default(uuid()) @db.Uuid
  invoiceId String        @db.Uuid
  itemId    String        @db.Uuid
  itemCode  String        @db.VarChar(50)
  itemName  String        @db.VarChar(200)
  quantity  Decimal       @db.Decimal(12, 3)
  weight    Decimal       @db.Decimal(12, 3)
  price     Decimal       @db.Decimal(15, 2)
  total     Decimal       @db.Decimal(15, 2)
  sortOrder Int           @default(0)
  invoice   ReturnInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      Item          @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
  @@map("return_invoice_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  type           PaymentType
  customerId     String?       @db.Uuid
  customerCode   String?       @db.VarChar(30)
  customerName   String?       @db.VarChar(200)
  supplierId     String?       @db.Uuid
  supplierCode   String?       @db.VarChar(30)
  supplierName   String?       @db.VarChar(200)
  seasonId       String        @db.Uuid
  amount         Decimal       @db.Decimal(15, 2)
  paymentMethod  PaymentMethod @default(cash)
  cashAmount     Decimal       @default(0) @db.Decimal(15, 2)
  instapayAmount Decimal       @default(0) @db.Decimal(15, 2)
  transferAmount Decimal       @default(0) @db.Decimal(15, 2)
  checkAmount    Decimal       @default(0) @db.Decimal(15, 2)
  receiptNumber  String?       @unique @db.VarChar(50)
  notes          String?
  reference      String?       @db.VarChar(100)
  date           DateTime      @default(now()) @db.Timestamptz(6)
  createdById    String        @db.Uuid
  deletedAt      DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  createdBy      User          @relation(fields: [createdById], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  season         Season        @relation(fields: [seasonId], references: [id])
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])

  @@index([customerId, type])
  @@index([supplierId, type])
  @@index([customerId, type, seasonId])
  @@index([supplierId, type, seasonId])
  @@index([seasonId, date(sort: Desc)])
  @@index([seasonId, createdAt(sort: Desc)])
  @@index([date(sort: Desc)])
  @@index([deletedAt])
  @@map("payments")
}

/// سجل كل حركة مخزونية — يُكتب فقط لا يُحذف ولا يُعدَّل أبداً
/// هو المصدر الوحيد للحقيقة (Single Source of Truth) للمخزون
model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  itemId         String            @db.Uuid
  itemCode       String            @db.VarChar(50)
  itemName       String            @db.VarChar(200)
  type           StockMovementType
  /// 양수 = دخول مخزن | سالب = خروج مخزن
  quantityIn     Decimal           @default(0) @db.Decimal(12, 3)
  quantityOut    Decimal           @default(0) @db.Decimal(12, 3)
  weightIn       Decimal           @default(0) @db.Decimal(12, 3)
  weightOut      Decimal           @default(0) @db.Decimal(12, 3)
  price          Decimal           @default(0) @db.Decimal(15, 2)
  warehouse      Warehouse
  /// بعد الحركة — لسهولة حساب الرصيد بدون aggregate
  balanceQty     Decimal           @default(0) @db.Decimal(12, 3)
  balanceWeight  Decimal           @default(0) @db.Decimal(12, 3)
  reference      String?           @db.VarChar(50)
  referenceModel String?           @db.VarChar(50)
  referenceId    String?           @db.Uuid
  seasonId       String?           @db.Uuid
  createdById    String            @db.Uuid
  date           DateTime          @default(now()) @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  createdBy      User              @relation(fields: [createdById], references: [id])
  item           Item              @relation(fields: [itemId], references: [id])
  season         Season?           @relation(fields: [seasonId], references: [id])

  @@index([itemId, warehouse, date(sort: Desc)])
  @@index([itemId, seasonId, date(sort: Desc)])
  @@index([itemId, warehouse, seasonId])
  @@index([seasonId, date(sort: Desc)])
  @@index([referenceId, referenceModel])
  @@index([type, date(sort: Desc)])
  @@index([date(sort: Desc)])
  @@map("stock_movements")
}

/// تسوية المخزون (جرد) — سجل مستقل لتمييزه من الحركات التلقائية
model StockAdjustment {
  id          String                @id @default(uuid()) @db.Uuid
  refNumber   String                @unique @db.VarChar(30)
  warehouse   Warehouse
  date        DateTime              @default(now()) @db.Timestamptz(6)
  notes       String?
  seasonId    String?               @db.Uuid
  createdById String                @db.Uuid
  approvedAt  DateTime?             @db.Timestamptz(6)
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt
  lines       StockAdjustmentLine[]
  createdBy   User                  @relation(fields: [createdById], references: [id])
  season      Season?               @relation(fields: [seasonId], references: [id])

  @@index([seasonId, date(sort: Desc)])
  @@index([warehouse, date(sort: Desc)])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           String          @id @default(uuid()) @db.Uuid
  adjustmentId String          @db.Uuid
  itemId       String          @db.Uuid
  itemCode     String          @db.VarChar(50)
  itemName     String          @db.VarChar(200)
  systemQty    Float
  systemWeight Decimal         @db.Decimal(12, 3)
  actualQty    Float
  actualWeight Decimal         @db.Decimal(12, 3)
  diffQty      Float
  diffWeight   Decimal         @db.Decimal(12, 3)
  notes        String?
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item         Item            @relation(fields: [itemId], references: [id])

  @@index([adjustmentId])
  @@index([itemId])
  @@map("stock_adjustment_lines")
}

model Transfer {
  id             String            @id @default(uuid()) @db.Uuid
  transferNumber String            @unique @db.VarChar(30)
  docNumber      String            @db.VarChar(50)
  direction      TransferDirection
  date           DateTime          @default(now()) @db.Timestamptz(6)
  fromWarehouse  Warehouse
  toWarehouse    Warehouse
  totalWeight    Decimal           @default(0) @db.Decimal(12, 3)
  totalQuantity  Decimal           @default(0) @db.Decimal(12, 3)
  status         ApprovalStatus    @default(pending)
  notes          String?
  seasonId       String?           @db.Uuid
  createdById    String            @db.Uuid
  approvedById   String?           @db.Uuid
  approvedAt     DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt
  items          TransferItem[]
  approvedBy     User?             @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  createdBy      User              @relation("TransferCreatedBy", fields: [createdById], references: [id])
  season         Season?           @relation(fields: [seasonId], references: [id])

  @@unique([docNumber, direction, seasonId])
  @@index([seasonId, status])
  @@index([seasonId, date(sort: Desc)])
  @@index([direction, status])
  @@map("transfers")
}

model TransferItem {
  id          String   @id @default(uuid()) @db.Uuid
  transferId  String   @db.Uuid
  itemId      String   @db.Uuid
  itemCode    String   @db.VarChar(50)
  itemName    String   @db.VarChar(200)
  quantity    Decimal  @db.Decimal(12, 3)
  weight      Decimal  @db.Decimal(12, 3)
  totalWeight Decimal  @db.Decimal(12, 3)
  sortOrder   Int      @default(0)
  item        Item     @relation(fields: [itemId], references: [id])
  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([itemId])
  @@map("transfer_items")
}

model ManufacturingOrder {
  id           String                     @id @default(uuid()) @db.Uuid
  orderNumber  String                     @db.VarChar(30)
  docNumber    String                     @default("") @db.VarChar(50)
  date         DateTime                   @default(now()) @db.Timestamptz(6)
  warehouse    Warehouse                  @default(ramses)
  workerId     String?                    @db.Uuid
  workerName   String?                    @db.VarChar(120)
  notes        String?
  status       ApprovalStatus             @default(pending)
  seasonId     String?                    @db.Uuid
  createdById  String                     @db.Uuid
  approvedById String?                    @db.Uuid
  approvedAt   DateTime?                  @db.Timestamptz(6)
  createdAt    DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                   @updatedAt
  approvedBy   User?                      @relation("ManufacturingApprovedBy", fields: [approvedById], references: [id])
  createdBy    User                       @relation("ManufacturingCreatedBy", fields: [createdById], references: [id])
  season       Season?                    @relation(fields: [seasonId], references: [id])
  worker       Worker?                    @relation(fields: [workerId], references: [id])
  outputs      ManufacturingOutput[]
  rawMaterials ManufacturingRawMaterial[]

  @@unique([seasonId, orderNumber])
  @@index([seasonId, status, createdAt(sort: Desc)])
  @@index([seasonId, warehouse, date(sort: Desc)])
  @@index([workerId, seasonId, date(sort: Desc)])
  @@map("manufacturing_orders")
}

model ManufacturingRawMaterial {
  id          String             @id @default(uuid()) @db.Uuid
  orderId     String             @db.Uuid
  itemId      String             @db.Uuid
  itemCode    String             @db.VarChar(50)
  itemName    String             @db.VarChar(200)
  quantity    Decimal            @db.Decimal(12, 3)
  weight      Decimal            @db.Decimal(12, 3)
  totalWeight Decimal            @db.Decimal(12, 3)
  sortOrder   Int                @default(0)
  item        Item               @relation(fields: [itemId], references: [id])
  order       ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([itemId])
  @@map("manufacturing_raw_materials")
}

model ManufacturingOutput {
  id          String             @id @default(uuid()) @db.Uuid
  orderId     String             @db.Uuid
  itemId      String             @db.Uuid
  itemCode    String             @db.VarChar(50)
  itemName    String             @db.VarChar(200)
  quantity    Decimal            @db.Decimal(12, 3)
  weight      Decimal            @db.Decimal(12, 3)
  totalWeight Decimal            @db.Decimal(12, 3)
  sortOrder   Int                @default(0)
  item        Item               @relation(fields: [itemId], references: [id])
  order       ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([itemId])
  @@map("manufacturing_outputs")
}

/// كل قيد في الخزينة — immutable (لا يُحذف ولا يُعدَّل)
/// التصحيح يكون بقيد عكسي (reversal)
model TreasuryEntry {
  id              String            @id @default(uuid()) @db.Uuid
  treasury        TreasuryType
  type            TreasuryEntryType
  amount          Decimal           @db.Decimal(15, 2)
  /// موجب = دخول | سالب = خروج
  direction       Int
  paymentMethod   PaymentMethod?
  referenceId     String?           @db.Uuid
  referenceModel  String?           @db.VarChar(50)
  referenceNumber String?           @db.VarChar(50)
  customerId      String?           @db.Uuid
  customerName    String?           @db.VarChar(200)
  supplierId      String?           @db.Uuid
  supplierName    String?           @db.VarChar(200)
  seasonId        String?           @db.Uuid
  userId          String?           @db.Uuid
  notes           String?
  /// هل هذا القيد reversal لقيد آخر؟
  reversalOf      String?           @db.Uuid
  date            DateTime          @default(now()) @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  customer        Customer?         @relation(fields: [customerId], references: [id])
  season          Season?           @relation(fields: [seasonId], references: [id])
  supplier        Supplier?         @relation(fields: [supplierId], references: [id])
  user            User?             @relation("TreasuryUser", fields: [userId], references: [id])

  @@index([treasury, date(sort: Desc)])
  @@index([treasury, type, date(sort: Desc)])
  @@index([treasury, seasonId, date(sort: Desc)])
  @@index([referenceId, referenceModel])
  @@index([customerId, date(sort: Desc)])
  @@index([supplierId, date(sort: Desc)])
  @@index([seasonId, date(sort: Desc)])
  @@index([date(sort: Desc)])
  @@map("treasury_entries")
}

/// سجل الصندوق اليومي لكل أدمن
model CashRegister {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  userName        String           @db.VarChar(120)
  type            CashRegisterType
  /// موجب = دخول | سالب = خروج
  direction       Int
  cashAmount      Decimal          @db.Decimal(15, 2)
  referenceId     String?          @db.Uuid
  referenceModel  String?          @db.VarChar(50)
  referenceNumber String?          @db.VarChar(50)
  customerId      String?          @db.Uuid
  customerName    String?          @db.VarChar(200)
  seasonId        String?          @db.Uuid
  notes           String?
  date            DateTime         @default(now()) @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  customer        Customer?        @relation(fields: [customerId], references: [id])
  season          Season?          @relation(fields: [seasonId], references: [id])
  user            User             @relation("CashRegisterUser", fields: [userId], references: [id])

  @@index([userId, date(sort: Desc)])
  @@index([userId, seasonId, date(sort: Desc)])
  @@index([seasonId, date(sort: Desc)])
  @@index([date(sort: Desc)])
  @@map("cash_registers")
}

model PriceList {
  id                   String              @id @default(uuid()) @db.Uuid
  priceListName        String              @db.VarChar(100)
  priceListDescription String              @default("") @db.VarChar(300)
  displayOrder         Int                 @default(0)
  displayName          String              @db.VarChar(200)
  origin               String              @default("") @db.VarChar(100)
  unit                 String              @default("") @db.VarChar(50)
  notes                String              @default("") @db.VarChar(500)
  prices               Json                @default("[]")
  defaultPrice         Decimal             @default(0) @db.Decimal(15, 2)
  itemDisplayOrder     Int                 @default(0)
  isActive             Boolean             @default(true)
  updatedById          String?             @db.Uuid
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  linkedItems          PriceListItemLink[]
  updatedBy            User?               @relation(fields: [updatedById], references: [id])

  @@index([priceListName, isActive])
  @@index([isActive])
  @@map("price_lists")
}

/// ربط قائمة الأسعار بالأصناف
model PriceListItemLink {
  id          String    @id @default(uuid()) @db.Uuid
  priceListId String    @db.Uuid
  itemId      String    @db.Uuid
  itemCode    String    @db.VarChar(50)
  itemName    String    @db.VarChar(200)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([priceListId])
  @@index([itemId])
  @@map("price_list_item_links")
}

/// سجل المراجعة — immutable تماماً — لا يُحذف أبداً
/// كل action في النظام يُسجَّل هنا
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  userName    String?     @db.VarChar(120)
  userRole    String?     @db.VarChar(30)
  action      AuditAction
  resource    String?     @db.VarChar(50)
  resourceId  String?     @db.Uuid
  resourceRef String?     @db.VarChar(50)
  /// الفرق قبل وبعد — { before: {...}, after: {...} }
  diff        Json?
  /// بيانات إضافية حرة
  meta        Json?
  ipAddress   String?     @db.VarChar(45)
  userAgent   String?     @db.VarChar(300)
  seasonId    String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  user        User?       @relation(fields: [userId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@index([action, createdAt(sort: Desc)])
  @@index([seasonId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// إشعارات داخل النظام — للتنبيه على الأحداث المهمة
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  title      String    @db.VarChar(200)
  body       String?
  type       String    @db.VarChar(50)
  resourceId String?   @db.Uuid
  isRead     Boolean   @default(false)
  readAt     DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// إعدادات النظام — key-value store مرن
model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// دور المستخدم في النظام — يُستخدم كـ coarse-grained access control
/// التفاصيل الدقيقة في UserPermission
enum Role {
  super_admin
  admin
  supervisor
  user
  viewer
}

/// المخازن المتاحة — قابل للتوسع بإضافة enum value
enum Warehouse {
  ramses
  october
}

/// نطاق صلاحية المستخدم على المخازن
enum WarehouseScope {
  ramses
  october
  both
}

/// نوع العميل من حيث طريقة الدفع الافتراضية
enum CustomerType {
  credit
  cash
}

/// حالة أي فاتورة في دورة حياتها
enum InvoiceStatus {
  draft
  pending
  approved
  suspended
  cancelled
  returned
}

/// حالة أوامر الإرجاع والتحويل والتصنيع
enum ApprovalStatus {
  pending
  approved
  rejected
}

/// طرق الدفع المتاحة
enum PaymentMethod {
  cash
  credit
  instapay
  transfer
  check
  mixed
}

/// نوع الدفعة المالية — لمن تذهب
enum PaymentType {
  customer_payment
  supplier_payment
}

/// طريقة استرداد المبلغ في المرتجعات
enum RefundMethod {
  cash
  bank
  credit_note
  none
}

/// نوع الخزينة
enum TreasuryType {
  cash
  bank
}

/// أنواع حركات الخزينة لتسهيل الاستعلامات والتقارير
enum TreasuryEntryType {
  sale_cash
  sale_bank
  purchase_cash
  purchase_bank
  payment_in_cash
  payment_in_bank
  payment_out_cash
  payment_out_bank
  return_in_cash
  return_in_bank
  return_out_cash
  return_out_bank
  expense
  adjustment
}

/// أنواع حركات كشف الصندوق
enum CashRegisterType {
  sale_cash
  payment_in
  payment_out
  return_in
  return_out
  expense
  adjustment
}

/// أنواع حركات المخزون — كاملة ومنطقية
enum StockMovementType {
  purchase_in
  sale_out
  return_in
  return_out
  transfer_in
  transfer_out
  manufacturing_in
  manufacturing_out
  adjustment_add
  adjustment_sub
  opening_stock
}

/// اتجاه التحويل بين المخازن
enum TransferDirection {
  ramses_to_october
  october_to_ramses
}

/// نوع المرتجع
enum ReturnType {
  customer_return
  supplier_return
}

/// الصلاحيات الحبيبية (Granular Permissions)
/// كل صلاحية هي flag مستقل يمكن منحه أو سحبه لأي user
enum Permission {
  sale_create
  sale_approve
  sale_edit
  sale_cancel
  sale_allow_negative
  purchase_create
  purchase_approve
  purchase_edit
  purchase_cancel
  return_create
  return_approve
  transfer_create
  transfer_approve
  manufacturing_create
  manufacturing_approve
  payment_create
  payment_edit
  payment_delete
  report_sales
  report_purchases
  report_stock
  report_treasury
  report_customers
  settings_users
  settings_items
  settings_suppliers
  settings_customers
  settings_seasons
  settings_price_lists
  settings_warehouses
  stock_adjustment
  treasury_view
  treasury_manage
}

/// أنواع أحداث الـ Audit للبحث والفلترة السريعة
enum AuditAction {
  invoice_created
  invoice_approved
  invoice_cancelled
  invoice_suspended
  invoice_edited
  invoice_restored
  return_created
  return_approved
  return_rejected
  payment_created
  payment_updated
  payment_deleted
  customer_created
  customer_updated
  customer_deleted
  supplier_created
  supplier_updated
  supplier_deleted
  stock_adjustment
  stock_transfer
  manufacturing_approved
  user_login
  user_logout
  user_created
  user_updated
  user_deactivated
  season_created
  season_activated
  season_closed
  treasury_entry_created
  treasury_adjustment
}
